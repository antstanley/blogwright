{
  "name": "blogwright-core",
  "version": "0.4.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rkey": {
      "types": "./dist/rkey.d.ts",
      "default": "./dist/rkey.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "oxlint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/credential-provider-env": "^3.972.77",
    "@aws-sdk/credential-provider-http": "^3.972.79",
    "@aws-sdk/credential-provider-ini": "^3.973.22",
    "@aws-sdk/credential-provider-node": "^3.972.89",
    "@aws-sdk/credential-provider-web-identity": "^3.972.83",
    "@smithy/credential-provider-imds": "^4.5.2",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "description": "SigV4 transport, per-service AWS HTTP clients, config, and S3 state store for blogwright",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antstanley/blogwright.git"
  },
  "engines": {
    "node": ">=22"
  }
}
