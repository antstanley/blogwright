{
  "name": "blogwright",
  "version": "0.4.0",
  "type": "module",
  "bin": {
    "blogwright": "./dist/bin.js",
    "bw": "./dist/bin.js"
  },
  "files": [
    "dist",
    "agent"
  ],
  "exports": {
    "./rkey": {
      "types": "./dist/rkey.d.ts",
      "default": "./dist/rkey.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-agent.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "oxlint src",
    "test": "vitest run",
    "start": "node ./dist/bin.js"
  },
  "dependencies": {
    "blogwright-core": "workspace:*",
    "blogwright-pds": "workspace:*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "blogwright-build-agent": "workspace:*",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "description": "Deploy static sites, single-page apps and server-rendered apps to AWS: S3 + CloudFront hosting, builds in a Lambda MicroVM, Lambda Web Functions for SSR, PR previews, GitHub-OIDC CI deploys, and plugins for analytics and standard.site publishing",
  "keywords": [
    "astro",
    "aws",
    "deploy",
    "s3",
    "cloudfront",
    "static-site",
    "atproto",
    "standard.site"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antstanley/blogwright.git"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/antstanley/blogwright#readme",
  "bugs": "https://github.com/antstanley/blogwright/issues"
}
