{
  "name": "blogwright-analytics",
  "blogwright": {
    "plugin": "analytics"
  },
  "version": "0.4.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "dist/app"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rolldown -c src/transform/rolldown.config.ts && node dist/write-transform-manifest.mjs && tsc -p tsconfig.json && cd app && vite build",
    "typecheck": "tsc -p tsconfig.typecheck.json && cd app && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "oxlint src app",
    "test": "vitest run",
    "dev:mock": "node scripts/dev-dashboard.mjs"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "blogwright-core": "workspace:*",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.62.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.5",
    "bits-ui": "^2.20.2",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "layerchart": "2.9.1",
    "oxlint": "^1.90.0",
    "rolldown": "^1.2.15",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "description": "Traffic analytics for blogwright: CloudFront access logs routed through Firehose into an Iceberg table, with a local dashboard. Installed on demand with `blogwright plugin add analytics`, never shipped with the CLI.",
  "keywords": [
    "analytics",
    "cloudfront",
    "firehose",
    "iceberg"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antstanley/blogwright.git"
  },
  "engines": {
    "node": ">=22"
  }
}
