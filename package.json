{
  "name": "blogwright-workspace",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint && oxlint playwright.config.ts tests/browser",
    "typecheck": "pnpm -r typecheck && pnpm typecheck:browser",
    "knip": "knip",
    "size:check": "node packages/size-budget/dist/bin.js check",
    "size:update": "node packages/size-budget/dist/bin.js update",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm install --no-frozen-lockfile",
    "dev:analytics": "pnpm --filter blogwright-analytics... build && pnpm --filter blogwright-analytics dev:mock",
    "test:ui": "playwright test --grep-invert @a11y",
    "test:a11y": "BROWSER_SUITE=a11y playwright test --grep @a11y",
    "test:ui:update": "playwright test --grep @visual --update-snapshots",
    "typecheck:browser": "tsc -p tests/browser/tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@e18e/eslint-plugin": "^0.8.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "blogwright": "workspace:*",
    "knip": "^6.43.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^6.0.3"
  }
}
