---
/**
 * A portrait card that links as a whole. The heading's link stretches over the
 * card, so screen readers hear one short link name, not the whole card. Cards
 * are rectangles at rest; hovering or focusing any card slants every card in
 * the grid, and the active one gets a yellow shadow. The slant lives on
 * ::before, so the text stays upright.
 */
import { Icon } from '@astrojs/starlight/components';
import type { ComponentProps } from 'astro/types';

interface Props {
  title: string;
  href: string;
  icon: ComponentProps<typeof Icon>['name'];
  cta?: string;
}

const { title, href, icon, cta = 'Read the guide' } = Astro.props;
---

<article class="app-card not-content">
  <Icon name={icon} class="app-card-icon" size="1.75rem" />
  <h2><a href={href}>{title}</a></h2>
  <div class="app-card-body"><slot /></div>
  <span class="app-card-cta" aria-hidden="true">{cta} →</span>
</article>

<style>
  .app-card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem 1.75rem;
    color: var(--sl-color-gray-2);
  }
  .app-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--sl-color-gray-6);
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }
  .app-card :global(.app-card-icon) {
    box-sizing: content-box;
    padding: 0.5rem;
    background: var(--sl-color-black);
    color: var(--sl-color-text);
  }
  h2 {
    margin: 0;
    font-size: var(--sl-text-h4);
    font-weight: 600;
    line-height: var(--sl-line-height-headings);
  }
  a {
    color: var(--sl-color-white);
    text-decoration: none;
  }
  /* Stretch the link over the whole card. */
  a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  a:focus-visible {
    outline: none;
  }
  .app-card:has(a:focus-visible)::before {
    outline: 2px solid var(--sl-color-text);
    outline-offset: 4px;
  }
  .app-card-body :global(p) {
    margin: 0;
  }
  .app-card-body :global(code) {
    font-size: 0.875em;
  }
  .app-card-cta {
    margin-top: auto;
    font-weight: 600;
    color: var(--sl-color-text-accent);
  }

  /* Hover or focus: every card in the grid slants; the active one also gets
     the hero button's yellow shadow. */
  .app-card {
    --app-card-shadow: #facc15;
  }
  :global([data-theme='light']) .app-card {
    --app-card-shadow: #eab308;
  }
  :global(.app-card-grid:has(.app-card:hover, a:focus-visible)) .app-card::before {
    transform: skewX(-4deg);
  }
  .app-card:is(:hover, :has(a:focus-visible))::before {
    box-shadow: 8px 8px 0 var(--app-card-shadow);
  }

  @media (prefers-reduced-motion: reduce) {
    .app-card::before {
      transition: none;
    }
  }
</style>
